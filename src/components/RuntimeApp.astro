---
import '../styles/studio.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="Thư viện lời Việt hoá anime của Rainei." />
    <title>Rainei · Lời Việt hoá</title>
    <link rel="icon" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <div id="app" data-base={base} data-url={import.meta.env.PUBLIC_SUPABASE_URL || ''} data-key={import.meta.env.PUBLIC_SUPABASE_ANON_KEY || ''}>
      <header class="topbar">
        <a class="brand" href={`${base}/`}><span class="brand-mark">r.</span><span>rainei<span class="brand-sub">LỜI VIỆT HOÁ</span></span></a>
        <nav><a href={`${base}/`} data-nav="library">Thư viện</a><a href={`${base}/?view=admin`} data-nav="admin">Quản lý</a></nav>
        <button id="admin-logout" class="btn topbar-logout" type="button" data-action="logout" hidden>Đăng xuất</button>
      </header>
      <div id="mode-banner" class="mode-banner" hidden></div>
      <main id="main" tabindex="-1"><p class="loading">Đang mở thư viện…</p></main>
      <footer><span>Rainei Lyrics List</span><span>Ảnh và thông tin phim từ <a href="https://anilist.co" target="_blank" rel="noopener noreferrer">AniList</a></span></footer>
      <div id="notice" role="status" aria-live="polite" hidden></div>
    </div>
    <script>import '../scripts/studio.mjs';</script>
  </body>
</html>
