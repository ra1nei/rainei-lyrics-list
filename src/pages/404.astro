---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Không tìm thấy trang | Rainei Lyrics List"
  description="Trang bạn tìm không tồn tại hoặc đã được đổi đường dẫn."
>
  <div class="flex flex-col items-center justify-center text-center min-h-[60vh] gap-4 px-4">
    <div class="text-6xl sm:text-8xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-purple-500">
      404
    </div>

    <h1 class="text-xl sm:text-2xl font-bold text-white">
      Không tìm thấy trang này
    </h1>

    <p class="text-slate-500 text-sm max-w-md">
      Đường dẫn có thể đã đổi, hoặc bài hát bạn tìm chưa được đăng.
    </p>

    <a
      href={base}
      class="mt-2 flex items-center gap-2 text-sm text-slate-300 hover:text-white transition-colors bg-slate-900/50 px-5 py-2.5 rounded-full border border-slate-800 hover:border-sky-500/50 hover:bg-slate-800"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Về trang chủ
    </a>
  </div>
</Layout>
