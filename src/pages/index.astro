---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getSeriesInfo, seriesIdOf, songIdOf, normalizeVi } from '../utils/songs';

const base = import.meta.env.BASE_URL;
const allSongs = await getCollection('songs');

// 1. VỪA CẬP NHẬT: so sánh theo timestamp cho chính xác tuyệt đối
const newUpdates = allSongs
  .filter((song) => song.data.date)
  .sort((a, b) => new Date(b.data.date!).getTime() - new Date(a.data.date!).getTime())
  .slice(0, 3);

// 2. LIST SERIES
const uniqueSeriesIds = [...new Set(allSongs.map((song) => seriesIdOf(song.slug)))];

const seriesList = uniqueSeriesIds
  .map((id) => {
    const info = getSeriesInfo(id);
    const songs = allSongs.filter((song) => seriesIdOf(song.slug) === id);

    // Gộp tên phim + tên bài + nghệ sĩ vào một chuỗi đã bỏ dấu để lọc phía client
    const haystack = normalizeVi(
      [
        info.vietnamese,
        info.romaji,
        String(info.year),
        ...songs.map((s) => s.data.title),
        ...songs.map((s) => s.data.artist ?? ''),
      ].join(' ')
    );

    // Ảnh bìa ưu tiên SERIES_MAP; series mới chưa khai báo thì lấy cover của bài đầu có.
    // CMS upload vào public/covers nên đường dẫn dạng /covers/... cần chèn base.
    let cover = info.cover ?? '';
    if (!cover) {
      const fromSong = songs.find((s) => s.data.cover)?.data.cover ?? '';
      cover = fromSong.startsWith('/covers/') ? base + fromSong : fromSong;
    }

    return { id, info, cover, count: songs.length, haystack };
  })
  .sort((a, b) => a.info.vietnamese.localeCompare(b.info.vietnamese, 'vi'));

const initialCover = seriesList[0]?.cover || '';
const totalSongs = allSongs.length;
---

<Layout
  title="Trang chủ | Rainei Lyrics List"
  description={`Tổng hợp lời Việt hoá ${totalSongs} bài hát thuộc ${seriesList.length} bộ phim, do mình thực hiện.`}
  isHome={true}
>

  <div class="flex flex-col px-4 sm:px-6 pb-4 pt-6 lg:h-full lg:pb-2 max-w-[1800px] mx-auto w-full">

    <div class="text-center shrink-0 mb-6">
       <h1 class="text-2xl sm:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-purple-500">
        Rainei Lyrics List
      </h1>
      <p class="text-slate-500 text-xs sm:text-sm mt-1">Tổng hợp lời Việt hoá các bài hát do mình thực hiện.</p>
    </div>

    <div class="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 lg:min-h-0 mb-4">

      <div class="hidden lg:block lg:col-span-4 h-full relative group rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900/50">
          <img
            id="preview-img"
            src={initialCover}
            class={`w-full h-full object-contain transition-all duration-700 ${initialCover ? '' : 'opacity-0'}`}
            alt="Preview"
          />
          <div
            id="preview-placeholder"
            class={`absolute inset-0 flex items-center justify-center bg-slate-800 text-slate-600 transition-opacity duration-500 ${initialCover ? 'opacity-0' : ''}`}
          >
             <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          </div>
      </div>

      <div class="lg:col-span-8 flex flex-col lg:h-full gap-6 min-w-0">

        <div class="bg-slate-900/40 border border-sky-500/20 rounded-xl p-3 sm:p-4 backdrop-blur-sm shrink-0">
            <div class="flex items-center gap-2 mb-3 text-sky-400 font-bold uppercase tracking-widest text-xs">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"></span>
              </span>
              Vừa cập nhật
            </div>

            <div class="grid gap-2">
              {newUpdates.length > 0 ? newUpdates.map((song) => {
                const seriesId = seriesIdOf(song.slug);
                const seriesName = getSeriesInfo(seriesId).vietnamese;

                return (
                  <a href={`${base}/series/${seriesId}#${songIdOf(song.slug)}`} class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-4 p-2 rounded hover:bg-white/5 group transition-colors min-w-0">
                    <div class="flex items-center gap-2 min-w-0 flex-1">
                       <span class="text-[10px] sm:text-xs font-bold text-sky-500/70 bg-sky-500/10 px-1.5 py-0.5 rounded border border-sky-500/20 whitespace-nowrap shrink-0 max-w-[40%] sm:max-w-none truncate">
                         {seriesName}
                       </span>
                       <span class="text-sm text-slate-300 group-hover:text-white truncate font-medium min-w-0">
                         {song.data.title}
                       </span>
                       {song.data.season && (
                         <span class="hidden sm:inline text-[10px] text-slate-500 border border-slate-700 px-1 rounded whitespace-nowrap shrink-0">
                           {song.data.season}
                         </span>
                       )}
                    </div>

                    <span class="text-[11px] sm:text-xs text-slate-600 font-mono whitespace-nowrap shrink-0">
                      {song.data.date ? song.data.date.toLocaleDateString('vi-VN') : ''}
                    </span>
                  </a>
                );
              }) : <div class="text-slate-500 text-sm italic">Chưa có dữ liệu mới.</div>}
            </div>
        </div>

        <div class="flex-1 flex flex-col lg:min-h-0 bg-slate-900/20 border border-slate-800/50 rounded-xl overflow-hidden">

            <div class="flex flex-col sm:flex-row sm:items-center gap-3 px-4 sm:px-5 py-3 border-b border-slate-800 bg-slate-900/50 shrink-0">
              <div class="text-xs font-bold text-slate-500 uppercase tracking-widest whitespace-nowrap">
                Danh sách phim
                <span class="text-slate-600 font-mono normal-case tracking-normal ml-1">({seriesList.length})</span>
              </div>

              <div class="relative sm:ml-auto w-full sm:w-56">
                <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-600 pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input
                  id="series-search"
                  type="search"
                  autocomplete="off"
                  placeholder="Tìm phim hoặc bài hát…"
                  aria-label="Tìm phim hoặc bài hát"
                  class="w-full bg-slate-950/50 border border-slate-800 rounded-lg pl-8 pr-3 py-1.5 text-sm text-slate-200 placeholder:text-slate-600 focus:outline-none focus:border-sky-500/60 focus:ring-1 focus:ring-sky-500/30 transition-colors"
                />
              </div>
            </div>

            <div id="series-list" class="lg:flex-1 lg:overflow-y-auto custom-scrollbar p-2">
              {seriesList.map((series) => (
                <a
                  href={`${base}/series/${series.id}`}
                  class="song-row group flex items-center gap-3 px-3 sm:px-4 py-3 hover:bg-slate-800/60 active:bg-slate-800/60 transition-all duration-200 cursor-pointer
                         border-b border-slate-800/50 last:border-b-0 rounded-lg hover:rounded-lg"
                  data-cover={series.cover}
                  data-search={series.haystack}
                >
                  <div class="flex flex-col min-w-0 flex-1 lg:group-hover:translate-x-1 transition-transform">
                      <div class="font-bold text-slate-300 group-hover:text-white text-base sm:text-lg leading-tight">
                          {series.info.vietnamese}
                          {series.info.year && <span class="text-slate-600 text-xs sm:text-sm font-normal ml-2">({series.info.year})</span>}
                      </div>
                      <div class="text-[11px] sm:text-xs text-slate-500 font-mono mt-1 group-hover:text-sky-500/70 transition-colors truncate">
                          {series.info.romaji}
                      </div>
                  </div>

                  <span class="shrink-0 text-[11px] font-mono text-slate-500 bg-slate-800/60 border border-slate-700/50 rounded-full px-2 py-0.5 group-hover:text-sky-400 group-hover:border-sky-500/30 transition-colors">
                    {series.count} bài
                  </span>
                </a>
              ))}

              <div id="series-empty" class="hidden text-center text-slate-500 text-sm italic py-8">
                Không tìm thấy phim hoặc bài hát nào khớp.
              </div>
            </div>
        </div>

      </div>
    </div>

    <div class="shrink-0 text-center border-t border-slate-900 pt-4 pb-[env(safe-area-inset-bottom,0px)] text-slate-600 text-xs">
        &copy; {new Date().getFullYear()} Rainei Lyrics List.
    </div>

  </div>

  <script>
    import { normalizeVi } from '../utils/songs';

    const previewImg = document.getElementById('preview-img') as HTMLImageElement | null;
    const placeholder = document.getElementById('preview-placeholder');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.song-row'));

    // Preview chỉ tồn tại ở desktop (cột trái ẩn dưới lg)
    if (previewImg && placeholder) {
      rows.forEach((row) => {
        row.addEventListener('mouseenter', () => {
          const cover = row.dataset.cover;
          if (cover) {
            previewImg.src = cover;
            previewImg.classList.remove('opacity-0');
            placeholder.classList.add('opacity-0');
          } else {
            previewImg.classList.add('opacity-0');
            placeholder.classList.remove('opacity-0');
          }
        });
      });
    }

    const search = document.getElementById('series-search') as HTMLInputElement | null;
    const empty = document.getElementById('series-empty');

    if (search && empty) {
      const applyFilter = () => {
        const q = normalizeVi(search.value.trim());
        let visible = 0;

        rows.forEach((row) => {
          const match = !q || (row.dataset.search ?? '').includes(q);
          row.classList.toggle('hidden', !match);
          if (match) visible++;
        });

        empty.classList.toggle('hidden', visible > 0);
      };

      search.addEventListener('input', applyFilter);

      // Esc để xoá nhanh ô tìm kiếm
      search.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          search.value = '';
          applyFilter();
        }
      });

      // Gõ "/" ở bất kỳ đâu để nhảy vào ô tìm kiếm
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== search) {
          e.preventDefault();
          search.focus();
        }
      });
    }
  </script>

</Layout>
